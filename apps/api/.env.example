# apps/api environment template - copy to a local .env and fill in.
#
# NOTE: config/env.py uses python-decouple AutoConfig(search_path=BASE_DIR) to
# read apps/api/.env for local development. Real process environment values
# still win, so deploy platform variables override this file. A real .env is
# gitignored; only this .env.example template is committed. Never commit secrets.

# --- Grounded answers (POST /api/answer/) ---------------------------------
# Required for /api/answer/. Server-side only; unset -> the endpoint returns 503.
GEMINI_API_KEY=
# Gemini model id (optional; this is the default).
GEMINI_MODEL=gemini-3.1-flash-lite
# Request timeout for Gemini calls (seconds). Invalid / non-positive -> 20.
GEMINI_TIMEOUT_SECONDS=20
# Answer provider (optional; `gemini` default). `fake` is DEBUG-only
# (DJANGO_DEBUG=true) for local UI verify without a key; rejected in production.
ANSWER_PROVIDER=gemini

# --- Core / security ------------------------------------------------------
# Set in any non-local environment. Leave unset locally to use the insecure dev key.
DJANGO_SECRET_KEY=
# "true" enables debug + the DRF browsable API (local only).
DJANGO_DEBUG=false
# Comma-separated allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated CORS allowlist (the frontend origins that may call this API).
DJANGO_CORS_ALLOWED_ORIGINS=https://piusagboola.com,http://localhost:5173,http://localhost:3000

# --- Layer S runtime foundations (optional; defaults shown) ----------------
# DJANGO_ANON_THROTTLE_RATE=60/min
# DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=1048576
